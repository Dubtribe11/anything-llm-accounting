{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "yarn vercel:install",
  "buildCommand": "yarn vercel:build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 3009,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
