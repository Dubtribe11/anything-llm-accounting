# Environment variables for a Vercel deployment.
#
# Set these in the Vercel project (Settings -> Environment Variables), not in a
# committed file. Copy this as a checklist. Full guide: VERCEL.md
#
# The theme of this file: nothing may depend on local disk or a long-lived
# process. Database, vector store and models are all external services.

# ---------------------------------------------------------------------------
# Required - serverless runtime
# ---------------------------------------------------------------------------
SERVERLESS_DEPLOYMENT="true"
NODE_ENV="production"
# Only /tmp is writable in a Vercel function, and it is wiped between cold starts.
STORAGE_DIR="/tmp/anythingllm-storage"

# ---------------------------------------------------------------------------
# Required - secrets
# ---------------------------------------------------------------------------
# Generate each with: openssl rand -hex 32
JWT_SECRET=""
SIG_KEY=""
SIG_SALT=""

# ---------------------------------------------------------------------------
# Required - database (Postgres, not SQLite)
# ---------------------------------------------------------------------------
# Any serverless-friendly Postgres works: Vercel Postgres, Neon, Supabase.
# Use the POOLED connection string - a serverless function opens a connection
# per invocation and will exhaust a direct connection limit.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true&connection_limit=1"

# ---------------------------------------------------------------------------
# Required - LLM (OpenRouter)
# ---------------------------------------------------------------------------
LLM_PROVIDER="openrouter"
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL_PREF="anthropic/claude-sonnet-4.5"
# Optional: raise if a model is slow to first token. Vercel's function timeout
# is the real ceiling - see maxDuration in vercel.json.
# OPENROUTER_TIMEOUT_MS="45000"

# ---------------------------------------------------------------------------
# Required - embedder
# ---------------------------------------------------------------------------
# The bundled native embedder needs onnxruntime-node and a writable model cache,
# so it cannot run here. Use an API-based embedder. OpenRouter reuses the key
# above.
EMBEDDING_ENGINE="openrouter"
EMBEDDING_MODEL_PREF="baai/bge-m3"
# Alternatively:
# EMBEDDING_ENGINE="openai"
# OPEN_AI_KEY="sk-..."
# EMBEDDING_MODEL_PREF="text-embedding-3-small"

# ---------------------------------------------------------------------------
# Required - vector database (external)
# ---------------------------------------------------------------------------
# LanceDB is the default but writes to local disk, so it cannot be used here.
# pgvector can share the Postgres instance above; the hosted options are also fine.
VECTOR_DB="pgvector"
PGVECTOR_CONNECTION_STRING="postgresql://user:password@host/db?sslmode=require"
PGVECTOR_TABLE_NAME="anythingllm_vectors"

# Or a hosted vector database:
# VECTOR_DB="pinecone"
# PINECONE_API_KEY=""
# PINECONE_INDEX=""
#
# VECTOR_DB="qdrant"
# QDRANT_ENDPOINT=""
# QDRANT_API_KEY=""
#
# VECTOR_DB="chroma"
# CHROMA_ENDPOINT=""

# ---------------------------------------------------------------------------
# Recommended
# ---------------------------------------------------------------------------
DISABLE_TELEMETRY="true"
# Multi-user mode is strongly recommended for anything holding client tax data.
# Turn it on from the UI after the first admin account is created.

# ---------------------------------------------------------------------------
# Optional - document collector
# ---------------------------------------------------------------------------
# Document upload and the "embed the tax reference library" button need the
# collector service. Run it separately (Railway, Fly.io, Render, a small VM)
# and point the app at it. Without it the app still works - the tax knowledge
# in the system prompt does not depend on the collector.
# COLLECTOR_ENDPOINT="https://your-collector.example.com"
