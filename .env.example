# Configuration for the Australian tax accounting build.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Only the three secrets and an LLM key are strictly required. Everything else
# has a working default.

# ---------------------------------------------------------------------------
# Required - secrets. Generate each with: openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET="replace-me-openssl-rand-hex-32"
SIG_KEY="replace-me-openssl-rand-hex-32"
SIG_SALT="replace-me-openssl-rand-hex-32"

# ---------------------------------------------------------------------------
# Required - the model provider
# ---------------------------------------------------------------------------
# OpenRouter gives you one key for every major model. Get one at
# https://openrouter.ai/keys
LLM_PROVIDER="openrouter"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL_PREF="anthropic/claude-sonnet-4.5"
# Raise this if a model is slow to first token.
# OPENROUTER_TIMEOUT_MS="45000"

# ---------------------------------------------------------------------------
# Embedder - for searching your own documents
# ---------------------------------------------------------------------------
# "native" runs locally in the container with no API key and no per-token cost.
# It is the right default for tax records: nothing leaves the machine to be
# embedded. Switch to openrouter/openai if you would rather not use the CPU.
EMBEDDING_ENGINE="native"

# EMBEDDING_ENGINE="openrouter"
# EMBEDDING_MODEL_PREF="baai/bge-m3"

# ---------------------------------------------------------------------------
# Vector database
# ---------------------------------------------------------------------------
# LanceDB is embedded in the container and stores vectors on the mounted volume.
# No external service, no extra cost. Change this only if you already run one of
# the supported vector databases.
VECTOR_DB="lancedb"

# ---------------------------------------------------------------------------
# Australian tax setup
# ---------------------------------------------------------------------------
# On first boot, create a workspace per entity type (individual, sole trader,
# trust, company, SMSF) with a tax profile attached, and turn on memory so
# context carries between them. Idempotent - it leaves an instance that already
# has workspaces alone. Set to "false" to start empty.
AU_TAX_AUTOSEED="true"

# ---------------------------------------------------------------------------
# Storage - do not change unless you also change the volume mount
# ---------------------------------------------------------------------------
STORAGE_DIR="/app/server/storage"

# ---------------------------------------------------------------------------
# Recommended
# ---------------------------------------------------------------------------
DISABLE_TELEMETRY="true"

# The host port to publish. Change if 3001 is taken.
# PORT="3001"

# Set these to the UID/GID that owns the mounted volume if you hit permission
# errors on Linux. Find them with: id -u; id -g
# UID="1000"
# GID="1000"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Multi-user mode is turned on from the UI after you create the first admin
# account. Use it for anything holding more than your own records.

# Password-protect a single-user instance instead:
# AUTH_TOKEN="a-password-you-choose"

# Whisper for audio transcription (local, no API key)
# WHISPER_PROVIDER="local"

# Agent web search - pick one and set its key
# AGENT_SEARCH_PROVIDER="searxng-engine"
# AGENT_SEARXNG_API_URL=""
